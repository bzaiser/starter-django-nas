# --- DJANGO ---
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
DESIGN_STUDIO_APP_NAME={{ app_name }}

# --- ADMIN BOOTSTRAP (erster Start) ---
DJANGO_ADMIN_USER=admin
DJANGO_ADMIN_EMAIL=admin@localhost
DJANGO_ADMIN_PASSWORD=admin

# --- INSTANZ / DOCKER / PORT ---
WEB_PORT=8000
CONTAINER_NAME={{ project_slug }}
IMAGE_NAME={{ project_slug }}_image
COMPOSE_PROJECT_NAME={{ project_slug }}
START_COMMAND="gunicorn config.wsgi:application --bind 0.0.0.0:8000 --workers 1 --threads 4"

# --- E-MAIL / SMTP ---
# Leer lassen für Konsolen-Ausgabe (Dev), für Produktion SMTP-Daten eintragen:
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@example.com
