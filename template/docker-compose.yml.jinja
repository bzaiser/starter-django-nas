services:
  web:
    build: .
    container_name: {{ project_slug }}
    restart: unless-stopped
    env_file: .env
    environment:
      - PYTHONPATH=/opt/ds-pkg
      - DESIGN_STUDIO_TARGET=/opt/ds-pkg
    ports:
      - "8000:8000"
    volumes:
      - ds_pkg:/opt/ds-pkg
      - app_data:/app/data

volumes:
  ds_pkg:
  app_data:
