services:
  web:
    image: {{ project_slug }}:latest
    container_name: {{ project_slug }}
    command: sh /app/entrypoint.sh
    restart: unless-stopped
    env_file: .env
    environment:
      - PYTHONPATH=/opt/ds-pkg
      - DESIGN_STUDIO_TARGET=/opt/ds-pkg
    ports:
      - "8000:8000"
    volumes:
      - .:/app
      - ./data:/app/data
      - ds_pkg:/opt/ds-pkg

volumes:
  ds_pkg:
