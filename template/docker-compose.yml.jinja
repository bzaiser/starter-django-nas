services:
  web:
    image: ${IMAGE_NAME:-{{ project_slug }}:latest}
    container_name: ${CONTAINER_NAME:-{{ project_slug }}}
    command: sh /app/entrypoint.sh
    restart: unless-stopped
    env_file: .env
    environment:
      - PYTHONPATH=/opt/ds-pkg
      - DESIGN_STUDIO_TARGET=/opt/ds-pkg
    ports:
      - "${WEB_PORT:-8000}:8000"
    volumes:
      - .:/app
      - ./data:/app/data
      - ds_pkg:/opt/ds-pkg

volumes:
  ds_pkg:
